  <!-- All 12 movements are modelled, so a vehicle reaching the junction has
       three candidate continuations and a route has something to choose. -->
  <junction id="100" name="crossing">
    <connection id="20" incomingRoad="1" connectingRoad="20" contactPoint="start">
      <laneLink from="1" to="-1"/>
    </connection>
    <connection id="21" incomingRoad="1" connectingRoad="21" contactPoint="start">
